{
  "title": "FraudShield API",
  "uid": "fraudshield",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "API up (1 = yes)",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
     "targets": [{"expr": "up{job=\"fraudshield-api\"}", "refId": "A"}]},
    {"id": 2, "type": "stat", "title": "Model version",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
     "options": {"textMode": "name"},
     "targets": [{"expr": "fraudshield_model_info", "legendFormat": "{{model_version}} (threshold {{threshold}})", "refId": "A"}]},
    {"id": 3, "type": "stat", "title": "Invalid requests (422), last 5 min",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
     "targets": [{"expr": "sum(increase(fraudshield_requests_total{status=\"422\"}[5m]))", "refId": "A"}]},
    {"id": 4, "type": "stat", "title": "Server errors (5xx), last 5 min",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
     "targets": [{"expr": "sum(increase(fraudshield_requests_total{status=~\"5..\"}[5m]))", "refId": "A"}]},
    {"id": 5, "type": "timeseries", "title": "Request rate (req/s) by endpoint",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
     "targets": [{"expr": "sum by (endpoint) (rate(fraudshield_requests_total[1m]))", "legendFormat": "{{endpoint}}", "refId": "A"}]},
    {"id": 6, "type": "timeseries", "title": "95th percentile latency (seconds)",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
     "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(fraudshield_request_latency_seconds_bucket[1m])))", "legendFormat": "p95", "refId": "A"}]},
    {"id": 7, "type": "timeseries", "title": "Predictions per second by outcome",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
     "targets": [{"expr": "sum by (outcome) (rate(fraudshield_predictions_total[1m]))", "legendFormat": "{{outcome}}", "refId": "A"}]},
    {"id": 8, "type": "timeseries", "title": "Responses per second by status code",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
     "targets": [{"expr": "sum by (status) (rate(fraudshield_requests_total[1m]))", "legendFormat": "{{status}}", "refId": "A"}]}
  ]
}